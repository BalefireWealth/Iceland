if(s.priceUSD!==undefined && s.priceUSD!==null && s.priceUSD!==''){const usd=Number(s.priceUSD),isk=Math.round(usd*rate);return `<p class="costline">≈ ISK ${pFmt(isk)} / ${dollar(usd)} USD <span class="pricing-sub">Est. four adults: ≈ ISK ${pFmt(isk*4)} / ${dollar(usd*4)} USD · ${esc(s.priceBasis||'per person')}</span>${s.priceNote?`<span class="pricing-sub">${esc(s.priceNote)}</span>`:''}</p>`;}
return s.cost?`<p class="costline">${esc(s.cost)}<span class="pricing-sub">No confirmed numeric ticket price available for conversion.</span></p>`:'';}

const isOptional=s=>/optional|alternative/i.test(s.tag||'');
