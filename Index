/* Offline vector map with fully local geography and native pins */
#map{height:410px;overflow:hidden;position:relative;background:#d9e9e8;touch-action:pan-y}
#map .geo-canvas{position:absolute;inset:0;overflow:hidden;cursor:grab}
#map .geo-canvas.dragging{cursor:grabbing;touch-action:none}
#geo-svg{position:absolute;width:100%;height:100%;inset:0}
#pin-layer,#map-city-labels{position:absolute;inset:0;pointer-events:none}
.pin-button{position:absolute;transform:translate(-50%,-50%);background:#087f78;color:#fff;border:2px solid #fff;box-shadow:0 2px 7px #143f4b66;border-radius:50%;font-size:11px;font-weight:900;width:27px;height:27px;cursor:pointer;pointer-events:auto;display:grid;place-items:center;padding:0;z-index:4}
.pin-button.optional{background:#ac8b57}.pin-button.map-cluster{background:#173f51;color:#fff;border:2px solid #d3bc85;min-width:32px;min-height:32px;box-shadow:0 2px 9px #102f4299}.pin-button.map-cluster:hover{background:#285d74}.pin-button:hover,.pin-button:focus{outline:3px solid #d7a74d;z-index:8;transform:translate(-50%,-50%) scale(1.18)}
.city-name{position:absolute;pointer-events:none;color:#436863;font-size:11px;font-weight:850;white-space:nowrap;text-shadow:0 1px 2px #fff,0 -1px 2px #fff;transform:translate(7px,5px)}
.map-controls{position:absolute;right:10px;top:12px;display:flex;flex-direction:column;border-radius:9px;overflow:hidden;box-shadow:0 2px 10px #102c3355;z-index:9}
.map-controls button{border:0;border-bottom:1px solid #c6d8d4;background:white;color:#225652;font-size:21px;font-weight:750;height:35px;width:37px;cursor:pointer}.map-controls button:last-child{border-bottom:0}
.map-detail{position:absolute;bottom:10px;left:10px;right:10px;padding:12px 38px 12px 12px;border-radius:11px;background:#fff;z-index:11;box-shadow:0 4px 18px #183b4760;border:1px solid #bed3ce}
.map-detail strong{display:block;font-size:13px;line-height:1.25}.map-detail small{font-size:11px;color:#647778;display:block;margin:4px 0 7px}.map-detail a{display:inline-block;max-width:100%;overflow-wrap:anywhere;font-size:11px;color:#087f78;font-weight:750;text-decoration:none;margin-right:13px}.map-detail a:hover{text-decoration:underline}.map-detail button{position:absolute;top:5px;right:8px;border:0;background:transparent;color:#69847f;font-size:20px;cursor:pointer}
