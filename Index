function prepAppCard(a){return `<article class="app-card"><div class="app-heading"><div class="app-logo ${a.className}" aria-label="Illustrative icon for ${esc(a.name)}"><span>${esc(a.symbol)}</span></div><div><div class="app-sub">${esc(a.type)}</div><h4>${esc(a.name)}</h4></div></div><p>${esc(a.summary)}</p><div class="app-steps"><strong>How we will use it</strong><div>${esc(a.how)}</div></div><div class="app-links">${a.ios?`<a target="_blank" rel="noopener noreferrer" href="${esc(a.ios)}">iPhone / App Store ↗</a>`:''}${a.android?`<a target="_blank" rel="noopener noreferrer" href="${esc(a.android)}">Android / Google Play ↗</a>`:''}<a target="_blank" rel="noopener noreferrer" href="${esc(a.site)}">${a.id==='road'?'Live road map':'Official info / resource'} ↗</a></div><div class="prep-flag">${esc(a.flag)}</div></article>`}
function prepChecklist(){return `<div class="prep-check-grid">${PREP_CHECKS.map((label,i)=>`<label class="prep-check"><input type="checkbox" data-prepcheck="${i}" ${DATA.prepChecks&&DATA.prepChecks[i]?'checked':''}><span>${esc(label)}</span></label>`).join('')}</div>`}
function refreshPrepProgress(){let done=PREP_CHECKS.filter((_,i)=>DATA.prepChecks&&DATA.prepChecks[i]).length;const n=$('prep-progress');if(n)n.textContent=`${done} of ${PREP_CHECKS.length} completed`;const bar=$('prep-meter-bar');if(bar)bar.style.width=100*done/PREP_CHECKS.length+'%';}
function renderPrep(){document.title='Travel Prep | '+DATA.heading;$('hero-title').textContent=DATA.heading;$('hero-deck').textContent=DATA.strap;$('side-season').textContent=DATA.season;$('fx-summary').innerHTML='<span><strong>Travel Prep:</strong> everyone can use this page without ChatGPT. App store links and live safety data require an internet connection. Checked items and edited notes save on this device only.</span>';tabnav();$('main-layout').classList.add('prep-mode');for(const id of ['day-intro','edit-tools','adventure-picker','stop-list','day-notes','travel-panel'])$(id).hidden=true;document.querySelector('.section-heading').hidden=true;document.querySelector('.side').hidden=true;const prep=$('prep-content');prep.hidden=false;
prep.innerHTML=`<div class="prep-top"><div class="prep-kicker">BEFORE WE GO · TRAVEL PREP</div><h2>Arrive ready. Explore with confidence.</h2><p>Simple app downloads, driving guidance for Stephanie, emergency contacts and a short language guide for Heidi, Steve, Stephanie and Wade. We will be self-driving, so the essential habit is to check Iceland’s official road and weather alerts before each departure.</p><div class="prep-hero-grid"><div class="prep-stat"><b>112</b><small>Emergency number</small></div><div class="prep-stat"><b>Right-hand</b><small>Same road side as the U.S.</small></div><div class="prep-stat"><b>English</b><small>Widely spoken in visitor areas</small></div></div></div>
<div class="prep-head"><h3>Six apps to recognize and prepare</h3><div class="prep-kicker">App-style icons are illustrative</div></div><div class="app-grid">${PREP_APPS.map(prepAppCard).join('')}</div>
<div class="prep-head"><h3>Phone & packing checklist</h3><span id="prep-progress" class="prep-kicker"></span></div><div class="prep-meter"><div id="prep-meter-bar"></div></div>${prepChecklist()}<div class="prep-head"><h3>Stephanie’s self-drive briefing</h3><span class="prep-kicker">Route 1 · South Coast · Golden Circle</span></div>
<div class="prep-steps">
<div class="prep-note-card"><h4>🚘 Driving rules — familiar, but not identical</h4><ul><li><b>Drive on the right</b> and pass on the left, as in the United States.</li><li>Typical limits unless otherwise signed: <b>50 km/h (31 mph)</b> in towns, <b>80 km/h (50 mph)</b> on gravel, <b>90 km/h (56 mph)</b> on rural paved highways.</li><li><b>Headlights on at all times</b>, including daylight. Seat belts for all four.</li><li><b>No right turn on a red light.</b> In roundabouts, yield appropriately to traffic already circulating; traffic in the inner lane has priority when exiting.</li><li>Do not pull off onto unmarked terrain. No F-roads or mountain shortcuts in early October.</li></ul><div class="prep-links"><a href="https://safetravel.is/driving/" target="_blank" rel="noopener noreferrer">SafeTravel driving guide ↗</a><a href="https://www.vegagerdin.is/en/home/exploring-iceland/driving-safely-in-iceland" target="_blank" rel="noopener noreferrer">Official road-safety rules ↗</a></div></div>
<div class="prep-note-card"><h4>🗺️ Navigation before starting every day</h4><ul><li>Use Google Maps for turn-by-turn guidance, but <b>Vegagerðin for road closures</b>; navigation apps do not override closures.</li><li>Download an offline map encompassing <b>KEF → Reykjavík → Hella → Vík → Golden Circle → Þingvellir</b>, with enough detail for smaller access roads.</li><li>Have Wade act as navigator, handling alerts, parking destinations and map updates while Stephanie drives.</li><li>Check <b>umferdin.is</b>, <b>en.vedur.is</b> and <b>safetravel.is</b> each morning and before long afternoon drives; avoid continuing during road or wind warnings.</li><li>Fill up around <b>Selfoss, Hvolsvöllur or Vík</b>; do not arrive at remote turns with a near-empty tank.</li></ul><div class="prep-links"><a href="https://umferdin.is/en" target="_blank" rel="noopener noreferrer">Official live roads ↗</a><a href="https://en.vedur.is/" target="_blank" rel="noopener noreferrer">Official weather ↗</a><a href="https://safetravel.is/" target="_blank" rel="noopener noreferrer">SafeTravel alerts ↗</a></div></div>
<div class="prep-note-card"><h4>🌬️ Reykjavík → Hella → waterfalls → Vík</h4><ul><li>The climb over <b>Hellisheiði</b> east of Reykjavík can be affected by fog, strong wind or early ice; check conditions before taking Route 1.</li><li>Pull into designated parking at <b>Seljalandsfoss and Skógafoss</b>; never stop for photos on the highway shoulder.</li><li><b>Dyrhólaey</b> access can be steep, exposed, rough and weather-restricted. Skip the upper viewpoint in poor visibility or strong gusts.</li><li>The signed access to <b>Sólheimajökull</b> includes a side road; check the latest surface and closure information before following GPS.</li><li><b>Reynisfjara</b> has potentially lethal sneaker waves; stay well back from the surf and obey closure lights. This is a walking safety issue, not a place to approach the water for photos.</li></ul></div>
<div class="prep-note-card"><h4>🏞️ Vík → Golden Circle → Þingvellir → west</h4><ul><li>Plan to retrace the maintained <b>Route 1 westbound</b>, then follow established roads toward Gullfoss and Geysir. Avoid unplanned shortcuts and anything signed F-road.</li><li>The interior roads can have <b>ice, gravel patches, blind rises and one-lane bridges</b>. Let oncoming traffic clear narrow structures before entering.</li><li>At <b>Gullfoss</b>, roads and footpaths may be wet or icy. Use the upper viewpoints if the group prefers fewer steps.</li><li>Approaching <b>Þingvellir</b>, check Route 36 and any connecting road you intend to use. Allow extra time if visibility is poor.</li><li>If adding <b>Hvammsvík</b> on the final day, the Hvalfjörður coastal detour means extra narrow-road driving; skip it in adverse weather or if everyone is tired.</li></ul></div>
<div class="prep-note-card"><h4>📱 Service, aurora & emergency planning</h4><ul><li>Cell service is generally good around settlements but can be weaker between them. A saved offline map is important; it is not a replacement for current road information.</li><li>For Northern Lights, compare <b>cloud cover and aurora activity</b>; choose a safe designated parking area away from traffic, and do not pull over on dark roads.</li><li>Call <b>112</b> for police, fire, ambulance or rescue emergencies. Use the 112 app if communicating by text or sharing location is easier.</li><li>For road condition information, <b>1777</b> is Vegagerðin’s traffic service in Iceland.</li></ul><div class="prep-links"><a href="https://en.vedur.is/weather/forecasts/aurora/" target="_blank" rel="noopener noreferrer">Official aurora and clouds ↗</a><a href="https://www.112.is/en/112-appid" target="_blank" rel="noopener noreferrer">112 emergency app ↗</a></div></div>
<div class="prep-note-card"><h4>🧳 Rental car and practical details</h4><ul><li>Choose an automatic with luggage room for four and ideally AWD for changing autumn conditions; AWD does <b>not</b> prevent sliding on ice.</li><li>Ask about wind-related door damage, gravel protection, sand/ash coverage, excess/deductible and roadside support.</li><li>Hold doors firmly when opening in wind; gusts can damage hinges and nearby parked cars.</li><li>Carry a physical valid U.S. driver’s license, confirm insurance paperwork, and check fuel type, lights, wipers and tire condition before departure.</li><li>Do the return trip to Keflavík in good time; autumn storms can alter driving schedules.</li></ul></div>
</div>
<div class="prep-head"><h3>Languages & easy phrases</h3><span class="prep-kicker">English will work in most tourism situations</span></div><div class="prep-note-card"><p><b>Icelandic</b> is the national language. <b>English is widely spoken</b>, particularly around Reykjavík, Vík, restaurants, hotels, tour operators and popular attractions. Many Icelanders also learn Danish; other languages vary. You do not need conversational Icelandic to comfortably travel this itinerary. The claim that “two-thirds speak English” isn't a number we would rely on; the tourism authority describes English as widely spoken.</p><p>Here are simple words you might hear or use:</p><div class="prep-words"><div class="prep-word"><strong>Halló</strong><span>Hello</span></div><div class="prep-word"><strong>Takk</strong><span>Thank you</span></div><div class="prep-word"><strong>Já / Nei</strong><span>Yes / No</span></div><div class="prep-word"><strong>Góðan daginn</strong><span>Good day / hello</span></div><div class="prep-word"><strong>Afsakið</strong><span>Excuse me / sorry</span></div><div class="prep-word"><strong>Hjálp</strong><span>Help</span></div><div class="prep-word"><strong>Útgangur</strong><span>Exit</span></div><div class="prep-word"><strong>Lokað</strong><span>Closed</span></div></div><div class="prep-flag">English is normally sufficient for this itinerary, but weather, road and closure alerts still need careful attention. A sign reading <b>Lokað</b> means “Closed”—never enter a closed road or attraction.</div></div>
<div class="prep-head"><h3>Family travel notes</h3><span class="prep-kicker">Editable & saved locally</span></div><div class="prep-note-card prep-editbox">${EDIT?`<label for="prep-note-input"><b>Update notes</b></label><textarea id="prep-note-input">${esc(DATA.prepNotes||'')}</textarea><button type="button" class="btn teal save-button" id="prep-save-notes">Save preparation notes</button>`:`<p>${esc(DATA.prepNotes||'')}</p><p style="color:#7a8c8a;font-size:12px">Select “Edit trip” above to change these notes; use “Publish-ready HTML” to share revised text with Heidi.</p>`}</div>
<div class="prep-head"><h3>Hidden finds along our driving route</h3><span class="prep-kicker">Optional • not new reservations</span></div>
<div class="prep-note-card"><p>Seven new optional pins were added across the Reykjavík, South Coast, Golden Circle and final-day tabs. Their day positions are suggestions; the original scheduled itinerary remains unchanged. Keep them only if weather, energy and timing permit.</p>
<ul><li><b>Highest-priority local discoveries:</b> Gljúfrabúi (by Seljalandsfoss), Kvernufoss (behind Skógar Museum), and Skálholt Cathedral (on the Golden Circle).</li>
<li><b>Good shorter alternatives:</b> Rútshellir cave by Skógafoss, the short paid-parking path to blue Brúarfoss, and a Reykjavík waterfall walk.</li>
<li><b>Another spa option:</b> Reykjaböð near Hveragerði is a potential substitute for Hvammsvík on the last full day. It leads to a different westbound driving route, so don't schedule both.</li>
<li><b>Beautiful but not on this trip:</b> Sænautasel turf house lies roughly 594 km from Reykjavík in the eastern highlands and is associated with summer access. Keldur turf farm is in South Iceland but normally opens inside only June–August. Instead, see the turf houses at Skógar Museum and the historical exhibits at Skálholt.</li></ul>
<div class="prep-links"><a target="_blank" rel="noopener noreferrer" href="https://guidetoiceland.is/connect-with-locals/jorunnsg/secret-waterfall-on-the-south-coast">Secret waterfall article ↗</a><a target="_blank" rel="noopener noreferrer" href="https://guidetoiceland.is/connect-with-locals/jorunnsg/chasing-waterfalls-in-iceland">Chasing Waterfalls article ↗</a><a target="_blank" rel="noopener noreferrer" href="https://guidetoiceland.is/connect-with-locals/regina/saenautasel-turf-house-i-the-highlands-of-iceland-2">Sænautasel article (outside route) ↗</a><a target="_blank" rel="noopener noreferrer" href="https://www.south.is/en/service/keldur-rangarvellir">Keldur official opening season ↗</a></div>
<p style="font-size:11px;color:#718782;margin-top:13px">Late September–early October is shoulder-season travel. Check closures, rough surfaces, waterfall spray, road conditions and daylight on the actual dates. A short hike is never compulsory for the full group.</p></div>
<div class="prep-head"><h3>Trusted resources</h3></div><div class="prep-note-card"><p>The app shortlist was adapted from the Guide to Iceland article you selected, with current official-service links and newer app alternatives where the original names or versions are no longer clear.</p><div class="prep-links"><a href="https://guidetoiceland.is/connect-with-locals/ashley-fasso/7-apps-for-iceland" target="_blank" rel="noopener noreferrer">Original 7-apps article ↗</a><a href="https://www.visiticeland.com/article/practical-information1/" target="_blank" rel="noopener noreferrer">Visit Iceland: language ↗</a><a href="https://travel.state.gov/en/international-travel/travel-advisories/iceland.html" target="_blank" rel="noopener noreferrer">U.S. State Department travel advice ↗</a></div><p style="font-size:11px;color:#718782;margin-top:13px">Information reviewed October 28, 2026. Download availability, regulations, and weather conditions may change before your 2027 trip. These are planning references, not live road or weather readings.</p></div>`;
