oute":"Reykjavík / overnight base → KEF airport","overnight":"Flight home","pace":"Easy • flight-dependent","stops":[{"id":"hotel-checkout-luggage-86081","time":"TBD","title":"Hotel checkout + luggage","desc":"Set the departure time based on the earlier of the two departing flights. Coordinate where the rental car, luggage and four travelers will be.","lat":64.1446,"lon":-21.9358,"url":"","kind":"logistics","tag":"Priority","cost":"","note":"","location":"Reykjavík"},{"id":"stephanie-returns-the-rental-car-at-kef-86591","time":"TBD","title":"Stephanie returns the rental car at KEF","desc":"Allow time to refuel, inspect the car, unload luggage and take any rental-company shuttle to the terminal. Verify desk hours for early departures.","lat":63.9847,"lon":-22.606,"url":"https://www.isavia.is/en/keflavik-airport","kind":"travel","tag":"Priority","cost":"","note":"","location":"Keflavík International Airport"},{"id":"heidi-steve-depart-for-milwaukee-86588","time":"TBD","title":"Heidi & Steve depart for Milwaukee","desc":"Enter flight details, connections and the check-in window once booked.","lat":63.9842,"lon":-22.6045,"url":"https://www.isavia.is/en/keflavik-airport","kind":"travel","tag":"Flight details TBD","cost":"","note":"","location":"Keflavík International Airport"},{"id":"stephanie-wade-depart-for-charlotte-86589","time":"TBD","title":"Stephanie & Wade depart for Charlotte","desc":"Enter flight details and allow the airline-recommended airport arrival time for international travel.","lat":63.9846,"lon":-22.6038,"url":"https://www.isavia.is/en/keflavik-airport","kind":"travel","tag":"Flight details TBD","cost":"","note":"","location":"Keflavík International Airport"}],"notes":"For international departures, follow your airline’s recommended check-in window. Typical drive from central Reykjavík to KEF is about 45–60 minutes in normal conditions, plus rental return and weather buffer. Confirm the last overnight location only after flight times are known."}],"rate