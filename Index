<script id="trip-boot-data" type="application/json">{"version":"2026-10-28-prep-v1","heading":"Iceland, Together","strap":"A thoughtful self-drive journey for Heidi, Steve, Stephanie & Wade","season":"Late September – early October 2027","travelers":"Heidi (69) · Steve (70) · Stephanie (40) · Wade (38)","flightHeidi":"TBD · Milwaukee → KEF","flightStephanie":"TBD · Charlotte → KEF","returnHeidi":"TBD · KEF → Milwaukee","returnStephanie":"TBD · KEF → Charlotte","meeting":"Meet in Reykjavík after both flights arrive","car":"Stephanie · rental car pickup at KEF · parking required","tripNote":"Five full days of experiences, with a travel day on each side. Tour times, rates and operating hours are planning estimates—not reservations. Optional local discoveries researched from Guide to Iceland have been placed alongside the closest existing day stops; the original confirmed sequence is unchanged. Sænautasel is too far east/highland and not included.","adventure":"katla","days":[{"id":"arrival","nav":"Arrival","eyebrow":"TRAVEL DAY • ARRIVAL","title":"Welcome to Iceland","lead":"Two flights, one reunion. Keep the arrival day intentionally open so everyone can recover from travel and begin the trip without a timetable.","route":"Keflavík International Airport → Reykjavík","overnight":"Reykjavík (hotel TBD)","pace":"Easy • arrival-dependent","stops":[{"id":"heidi-steve-arrive-from-milwaukee-86591","time":"TBD","title":"Heidi & Steve arrive from Milwaukee","desc":"Flight into Keflavík International Airport (KEF). Arrival time, connecting flight and transfer plan to Reykjavík to be added once flights are booked.","lat":63.985,"lon":-22.6056,"url":"https://www.isavia.is/en/keflavik-airport","kind":"travel","tag":"Flight details TBD","cost":"","note":"","location":"Keflavík International Airport"},{"id":"stephanie-wade-arrive-from-charlotte-86587","time":"TBD","title":"Stephanie & Wade arrive from Charlotte","desc":"Flight into KEF. Stephanie picks up the rental car at the airport; check rental pickup desk hours, full-size luggage capacity, insurance and winter/weather terms.","lat":63.98515,"lon":-22.6025,"url":"https://www.isavia.is/en/keflavik-airport","kind":"travel","tag":"Flight details TBD","cost":"","note":"","location":"Keflavík International Airport"},{"id":"meet-in-reykjav-k-check-in-86088","time":"After both arrivals","title":"Meet in Reykjavík + check in","desc":"Reunite in Reykjavík, settle into the hotel, refresh and rest. A downtown hotel with a sauna or small spa is an option, not a fixed booking. Request parking or nearby overnight garage details.","lat":64.1469,"lon":-21.9408,"url":"","kind":"hotel","tag":"Priority","cost":"","note":"","location":"Downtown Reykjavík, Iceland"},{"id":"harpa-and-the-old-harbour-86082","time":"Late afternoon • optional","title":"Harpa and the Old Harbour","desc":"An easy harbor walk, architectural stop and warm drink. Only do this if everyone feels comfortable after flights.","lat":64.1501,"lon":-21.9324,"url":"https://www.harpa.is/en/","kind":"history","tag":"Optional","cost":"","note":"","location":"Harpa Concert Hall, Reykjavík"},{"id":"messinn-icelandic-seafood-dinner-86087","time":"Dinner • flexible","title":"Messinn — Icelandic seafood dinner","desc":"Fresh Icelandic fish served in hot pans, often with potatoes and vegetables; a relaxed dinner that is easy to keep flexible around arrivals.","lat":64.1478,"lon":-21.9388,"url":"https://www.messinn.com/en","kind":"food","tag":"Priority","cost":"À la carte; verify hours for travel date.","note":"","location":"Messinn, Lækjargata 6b, Reykjavík"},{"id":"matur-og-drykkur-tasting-menu-alternative-86100","time":"18:00 onward • optional","title":"Matur og Drykkur — tasting-menu alternative","desc":"For a special first-night dinner if flights arrive early: refined, heritage-driven Icelandic tasting menu. Longer meal and limited dinner opening days; book only after flights are known.","lat":64.1543,"lon":-21.9455,"url":"https://en.maturogdrykkur.is/","kind":"food","tag":"Optional","cost":"Premium fixed tasting menu.","note":"","location":"Matur og Drykkur, Mýrargata 31, Reykjavík"},{"id":"sky-lagoon-optional-arrival-day-spa-86062","time":"If flights land early","title":"Sky Lagoon — optional arrival-day spa","desc":"Ocean-view geothermal bathing in nearby Kópavogur. Reserve only once flight times are known; 2–2.5 hours including changing is realistic.","lat":64.1137,"lon":-21.9479,"url":"https://www.skylagoon.com/","kind":"spa","tag":"Optional","cost":"Saman from ISK 14,990/adult; Sér from ISK 17,990/adult. 2026 starting prices; 2027 unconfirmed.","note":"Best saved for another day if jet-lagged.","location":"Sky Lagoon, Vesturvör 44-48, Kópavogur","priceISK":14990,"priceBasis":"per adult · Saman starting admission","priceNote":"2026 published; Sér from ISK 17,990; visit on arrival OR Day 1"}],"notes":"Travel coordinator: Stephanie is the designated driver. KEF is outside Reykjavík, so coordinate separate airport-to-city transfer if the Milwaukee flight arrives significantly earlier. Choose downtown parking before confirming a hotel; plan meals around actual arrivals."},{"id":"city","nav":"Day 1","eyebrow":"FULL DAY 1 • REYKJAVÍK","title":"Reykjavík — history, local food & easy exploring","lead":"An unhurried introduction to Reykjavík: a choice of compact museums and a guided food tour, with Sky Lagoon available in the late afternoon or evening if you did not visit on arrival day.","route":"Downtown Reykjavík • short taxi/car transfers as needed","overnight":"Reykjavík","pace":"Easy / moderate • food walk ≈ 2 km","stops":[{"id":"the-settlement-exhibition-86088","time":"9:45–10:45","title":"The Settlement Exhibition","desc":"See the remains of a Viking-age longhouse and learn how Reykjavík began. Indoors; a strong first stop with modest walking.","lat":64.1473,"lon":-21.9414,"url":"https://reykjavik.is/en/settlement-exhibition","kind":"history","tag":"Priority","cost":"Museum admission; check 2027 rates.","note":"Official hours currently 10:00–17:00; arrive at 10:00 if preferred.","location":"The Settlement Exhibition, Aðalstræti 16, Reykjavík"},{"id":"national-museum-of-iceland-86089","time":"11:05–11:50","title":"National Museum of Iceland","desc":"Browse key highlights of Icelandic history from settlement onward. Make this a highlights-only visit rather than trying to tour every gallery.","lat":64.1414,"lon":-21.948,"url":"https://www.thjodminjasafn.is/english","kind":"history","tag":"Optional","cost":"Ticketed museum.","note":"Keep as optional if museums back-to-back feel repetitive.","location":"National Museum of Iceland, Suðurgata 41, Reykjavík"},{"id":"harpa-meeting-point-short-break-86083","time":"12:15–12:30","title":"Harpa meeting point + short break","desc":"Arrive at Harpa Concert Hall with time for a restroom and coffee before the food tour. Confirm the food-tour departure time before finalizing the morning.","lat":64.1503,"lon":-21.9329,"url":"https://www.harpa.is/en/","kind":"logistics","tag":"Priority","cost":"","note":"","location":"Harpa Concert Hall, Austurbakki 2, Reykjavík"},{"id":"reykjav-k-food-walk-86082","time":"12:30–15:30 • target","title":"Reykjavík Food Walk","desc":"Small-group food tour featuring Icelandic specialties and local stories. Approx. 3 hours and 2 km / 1.2 miles spread across multiple seated tasting stops; check departure slots.","lat":64.1497,"lon":-21.9317,"url":"https://www.thereykjavikfoodwalk.com/","kind":"food","tag":"Priority","cost":"Current operator pricing and 2027 slots TBD.","note":"If the walking distance is too much, substitute a seated Icelandic lunch and museum visit.","location":"Reykjavík Food Walk, Harpa departure, Reykjavík","priceISK":15500,"priceBasis":"per adult · published gift-card reference","priceNote":"Tour booking prices may differ, verify for 2027"},{"id":"hallgr-mskirkja-neighborhood-86069","time":"16:00–16:30","title":"Hallgrímskirkja & neighborhood","desc":"Drive or take a short taxi for exterior views of the iconic church; tower visit optional if operating. Keep the stop short and weather-dependent.","lat":64.1418,"lon":-21.9266,"url":"https://www.hallgrimskirkja.is/","kind":"sight","tag":"Optional","cost":"Tower admission may apply.","note":"","location":"Hallgrímskirkja, Reykjavík"},{"id":"sky-lagoon-city-optional-v2","time":"16:30–19:00 • optional","title":"Sky Lagoon — optional Day 1 spa","desc":"Oceanfront geothermal lagoon in Kópavogur, around 15–20 minutes from central Reykjavík under normal conditions. Choose Sky Lagoon on EITHER arrival day or Day 1—not twice unless you want two visits. Book the ritual and allow about 2–2.5 hours with changing. Move or skip the church stop if you select this afternoon option.","lat":64.1137,"lon":-21.9479,"url":"https://www.skylagoon.com/booking/enhance/","kind":"spa","tag":"Optional","cost":"Saman from ISK 14,990/adult; Sér from ISK 17,990/adult. 2026 starting prices; 2027 unconfirmed.","note":"Arrival-day visit is also listed. Select one day after flight arrival times are known; rental car parking at Sky Lagoon is available; confirm current parking details.","location":"Sky Lagoon, Vesturvör 44-48, Kópavogur, Iceland","priceISK":14990,"priceBasis":"per adult · Saman starting admission","priceNote":"2026 published; Sér from ISK 17,990; visit on arrival OR Day 1"},{"id":"light-dinner-or-hotel-spa-86084","time":"Evening • flexible","title":"Light dinner or hotel spa","desc":"The food walk can be substantial, so a light dinner or an evening at the hotel may be enough. Alternatively enjoy Sky Lagoon if it was skipped on arrival.","lat":64.1461,"lon":-21.9377,"url":"https://www.skylagoon.com/","kind":"spa","tag":"Optional","cost":"","note":"","location":"Downtown Reykjavík / Sky Lagoon"},{"id":"local-find-ellidaa-2027","time":"Midday or late afternoon • optional","title":"Elliðaárdalur — Reykjavík waterfall walk","desc":"A quieter green valley inside Reykjavík, with small cascades and local trails. The marked 2.5 km Hólmi circuit takes about 30–60 minutes; choose just a short section if the group prefers less walking. A nature alternative to another downtown museum, NOT an additional required activity.","lat":64.1105,"lon":-21.83,"url":"https://visitreykjavik.is/reykjavik-outdoor-activities-near-centre","kind":"sight","tag":"Optional discovery","cost":"Free paths; walking surfaces can be uneven.","note":"Official tourist-board guide labels this an easy, mixed-surface walk. Only do it in daylight and if the weather and everyone’s energy permit.","location":"Elliðaárdalur Valley, Reykjavík, Iceland","priceISK":0,"priceBasis":"free admission"}],"notes":"Walking management: the food walk is optional for anyone who cannot comfortably cover approximately 2 km. Reserve a meeting-time-compatible tour; times shown are not confirmed bookings. Avoid using the rental car for every downtown block—park once or take short rides. Sky Lagoon appears on both the arrival and Day 1 tabs for planning flexibility; book it on just one of those days."},{"id":"coast","nav":"Day 2","eyebrow":"FULL DAY 2 • DRIVE TO VÍK","title":"Reykjavík → Vík | The iconic South Coast","lead":"The west-to-east driving order from your rebuilt South Coast PDF is preserved: history, waterfalls, Icelandic farm lunch, turf houses and dramatic black-sand coastline.","route":"Reykjavík → Hella → Seljalandsfoss → Skógar → Vík","overnight":"Vík • first night","pace":"Full • 8 AM departure recommended","stops":[{"id":"depart-reykjav-k-86090","time":"08:00","title":"Depart Reykjavík","desc":"Drive east on Route 1. Refuel and make a restroom stop before the first timed activity.","lat":64.1466,"lon":-21.9426,"url":"https://umferdin.is/en","kind":"travel","tag":"Priority","cost":"","note":"","location":"Reykjavík"},{"id":"caves-of-hella-guided-historical-tour-84235","time":"09:45–11:15","title":"Caves of Hella — guided historical tour","desc":"Target 9:50 check-in for a 10:00 guided 60–75 minute tour. Learn about mysterious hand-carved caves and local history. Check stairs and uneven surfaces.","lat":63.8365,"lon":-20.3988,"url":"https://www.cavesofhella.is/tours","kind":"history","tag":"Priority","cost":"PDF reference: ISK 6,950/adult (2027 unconfirmed).","note":"Reserve exact tour slot; if unavailable substitute LAVA Centre.","location":"Caves of Hella, Ægissíða, Hella","priceISK":6950,"priceBasis":"per adult · attached PDF planning reference","priceNote":"2027 not confirmed"},{"id":"seljalandsfoss-waterfall-83605","time":"11:45–12:25","title":"Seljalandsfoss waterfall","desc":"Enjoy the waterfall from its main accessible viewing area. The behind-the-waterfall path is an optional slippery extension, not a group requirement.","lat":63.6156,"lon":-19.9886,"url":"https://www.south.is/en/place/seljalandsfoss-waterfall","kind":"sight","tag":"Priority","cost":"Free entry; parking extra.","note":"","location":"Seljalandsfoss, South Iceland","priceISK":0,"priceBasis":"free general admission · parking may cost extra","priceNote":"Road and parking fees excluded"},{"id":"local-find-gljufrabui-2027","time":"During Seljalandsfoss stop • optional","title":"Gljúfrabúi — hidden waterfall by Seljalandsfoss","desc":"The “secret waterfall” from Jórunn’s Guide to Iceland article. About 600 m from Seljalandsfoss, with a mostly level approach to the cleft in the cliff. The full waterfall is hidden inside a narrow gorge; entering requires stepping through running water and over slippery rocks. For Heidi and Steve, the outer path is the conservative choice. Allow extra time only if weather permits.","lat":63.6209,"lon":-19.9862,"url":"https://guidetoiceland.is/connect-with-locals/jorunnsg/secret-waterfall-on-the-south-coast","kind":"sight","tag":"Optional discovery","cost":"Free viewing; Seljalandsfoss parking fee may apply.","note":"A discovery next to an existing stop, not a second long waterfall excursion. Do not attempt the watery canyon if slick or high water.","location":"Gljúfrabúi Waterfall, South Iceland","priceISK":0,"priceBasis":"free admission"},{"id":"gamla-fj-si-farmhouse-lunch-83401","time":"12:35–13:25","title":"Gamla Fjósið — farmhouse lunch","desc":"Eat at the family-run restaurant in a former cowhouse. Reservations and autumn opening hours should be confirmed.","lat":63.5538,"lon":-19.8468,"url":"https://gamlafjosid.is/","kind":"food","tag":"Priority","cost":"À la carte.","note":"","location":"Gamla Fjósið, South Iceland"},{"id":"local-find-rutshellir-2027","time":"13:30–13:45 • optional","title":"Rútshellir — historic turf-roof cave stop","desc":"A small man-made cave and historic sheep-shed structure directly off Route 1, about 3 km west of Skógafoss. A low-commitment outdoor peek at local farming history, especially interesting after Caves of Hella. Replace a little photo time elsewhere rather than overpacking the day; avoid entering if wet or footing is uncertain.","lat":63.52646,"lon":-19.551,"url":"https://guidetoiceland.is/connect-with-locals/regina/the-peculiar-rutshellir-cave-in-south-iceland","kind":"history","tag":"Optional discovery","cost":"No usual admission; parking/access should be checked.","note":"Adjacent working-land setting; stay on marked access, follow signage and respect boundaries.","location":"Rútshellir Cave, Drangshlíð, Iceland","priceISK":0,"priceBasis":"free admission"},{"id":"sk-gafoss-waterfall-83043","time":"13:45–14:20","title":"Skógafoss waterfall","desc":"Enjoy the enormous waterfall from the base. The long staircase is optional and not part of the main plan.","lat":63.5321,"lon":-19.5114,"url":"https://www.south.is/en/place/skogafoss-waterfall","kind":"sight","tag":"Priority","cost":"Free entry; parking may apply.","note":"","location":"Skógafoss, Skógar, Iceland","priceISK":0,"priceBasis":"free general admission · parking may cost extra","priceNote":"Road and parking fees excluded"},{"id":"sk-gar-museum-83031","time":"14:25–15:20","title":"Skógar Museum","desc":"Explore Icelandic turf houses, farming artifacts, folk history and maritime life. Select fewer exhibits if tired.","lat":63.5242,"lon":-19.5066,"url":"https://www.skogasafn.is/opening-hours-and-bookings/","kind":"history","tag":"Priority","cost":"PDF reference: ISK 3,000/adult; 2,000/senior. 2027 unconfirmed.","note":"","location":"Skógar Museum, Skógar, Iceland","priceISK":3000,"priceBasis":"adult · ISK 2,000 senior","priceNote":"2026 PDF reference; for 2 adults + 2 seniors group estimate ISK 10,000","priceGroupISK":10000},{"id":"local-find-kvernufoss-2027","time":"During museum visit • optional hike","title":"Kvernufoss — hidden gorge walk behind Skógar Museum","desc":"A beautiful gorge waterfall directly behind Skógar Museum. The walk commonly takes 15–25 minutes each way and includes a fence stile, uneven paths and wet sections. Ideal optional Stephanie + Wade walk while Heidi and Steve visit the museum; NOT a group requirement. Do not walk behind the cascade when wet, windy or slippery.","lat":63.52856,"lon":-19.4813,"url":"https://guidetoiceland.is/connect-with-locals/regina/the-beautiful-kvernufoss-waterfall-the-less-visited-neighbour-of-skogafoss-waterfall-in-south-iceland","kind":"sight","tag":"Optional discovery","cost":"Free to view; confirm museum-area parking terms.","note":"Allow approximately 45–60 minutes round-trip with photos. Best as an alternative to the full museum visit for the younger couple.","location":"Kvernufoss Waterfall, Skógar, Iceland","priceISK":0,"priceBasis":"free admission"},{"id":"dyrh-laey-coastal-viewpoints-82534","time":"15:50–16:20","title":"Dyrhólaey coastal viewpoints","desc":"Cliffs, ocean arch and black-sand panorama. Skip exposed upper roads in dangerous wind or if the route is closed.","lat":63.4044,"lon":-19.1303,"url":"https://www.south.is/en/place/dyrholaey","kind":"sight","tag":"Priority","cost":"Free viewing; weather/access dependent.","note":"","location":"Dyrhólaey Viewpoint, Iceland","priceISK":0,"priceBasis":"free general admission · parking may cost extra","priceNote":"Road and parking fees excluded"},{"id":"reynisfjara-black-sand-beach-82449","time":"16:35–17:00","title":"Reynisfjara black-sand beach","desc":"See basalt columns and black sand from the safe designated viewing area. Stay far from surf: sneaker waves can be deadly.","lat":63.4047,"lon":-19.0437,"url":"https://safetravel.is/","kind":"sight","tag":"Priority","cost":"Free viewing; parking may apply.","note":"Never walk close to the waterline.","location":"Reynisfjara Black Sand Beach, Vík","priceISK":0,"priceBasis":"free general admission · parking may cost extra","priceNote":"Road and parking fees excluded"},{"id":"v-k-check-in-optional-su-ur-v-k-dinner-82425","time":"17:15 onward","title":"Vík check-in + optional Suður-Vík dinner","desc":"Settle into Vík. A relaxed dinner at Suður-Vík around 18:30 is an optional target if everyone has energy.","lat":63.419,"lon":-19.0062,"url":"https://sudurvik.is/","kind":"food","tag":"Priority","cost":"À la carte.","note":"","location":"Suður-Vík restaurant, Vík"}],"notes":"This exact sequence is from your Reykjavík→Vík PDF. It is a full day and times assume smooth road conditions. LAVA Centre near Hvolsvöllur is a substitute for Caves of Hella or Skógar Museum—not an extra scheduled stop. Prioritize safe viewpoint access over completing every stop."},{"id":"vik","nav":"Day 3","eyebrow":"FULL DAY 3 • VÍK ADVENTURE","title":"Vík — choose ONE glacier-area adventure","lead":"Keep one full day based in Vík. Select an ice cave, a buggy ride or a true guided glacier hike; follow with food, local crafts and a relaxed village afternoon.","route":"Vík and nearby glacier departure points","overnight":"Vík • second night","pace":"Activity-dependent • variable footing","stops":[{"id":"option-a-katla-ice-cave-super-jeep-82425","time":"10:00–13:00 • target","title":"OPTION A · Katla Ice Cave + Super Jeep","desc":"Depart Vík for a guided 4×4 experience to a natural ice cave. Crampons and uneven ice, possible steps or ladders. More accessible than a long hike in duration, but not risk-free.","lat":63.4187,"lon":-19.0058,"url":"https://www.southadventure.is/tours/katla-ice-cave-tour/","kind":"glacier","tag":"One of three","cost":"PDF reference: from ISK 29,990/person; unconfirmed 2027.","note":"Confirm mobility/steps/vehicle ride with operator before booking.","location":"Katla Ice Cave tour departure, Vík","choice":"katla","priceISK":29990,"priceBasis":"per adult · from attached PDF","priceNote":"2026 planning reference; 2027 availability and price not confirmed"},{"id":"option-b-glacier-buggy-to-plane-wreck-82916","time":"10:00–12:00 • target","title":"OPTION B · Glacier buggy to plane wreck","desc":"Buggy ride over black sands and river crossings to an aircraft wreck. This DOES NOT drive on glacier ice. Meeting base roughly 40–50 minutes west of Vík; check in 30 minutes early.","lat":63.5321,"lon":-19.384,"url":"https://www.mountainguides.is/tour/glacier-buggy-experience-myrdalsjokull","kind":"glacier","tag":"One of three","cost":"PDF reference: from USD $286/person; unconfirmed 2027.","note":"Allow transport time and verify minimum driver/passenger rules.","location":"Mýrdalsjökull glacier buggy tour departure, South Iceland","choice":"buggy","priceUSD":286,"priceBasis":"per person · from attached PDF","priceNote":"Buggy rules may price per vehicle; verify 2027 price"},{"id":"option-c-private-s-lheimaj-kull-glacier-hike-82895","time":"10:00–12:30 • target","title":"OPTION C · Private Sólheimajökull glacier hike","desc":"A genuine guided hike on glacier ice with crampons. Private guide can tailor pace; the 2–2.5 hour hike still involves uneven and slippery terrain. Drive roughly 40–50 min each way from Vík.","lat":63.5308,"lon":-19.3639,"url":"https://www.mountainguides.is/tour/private-glacier-walk","kind":"glacier","tag":"One of three","cost":"Private tour pricing by request.","note":"For Heidi and Steve, confirm terrain, balance and fitness requirements with the guide; never attempt unguided glacier travel.","location":"Sólheimajökull glacier parking / tour meeting area","choice":"hike"},{"id":"the-soup-company-lunch-82425","time":"13:15–14:15 • flexible","title":"The Soup Company — lunch","desc":"Hearty Icelandic-style soup and fresh bread. If you choose the buggy or glacier hike, move lunch later to allow the return drive.","lat":63.4167,"lon":-19.0076,"url":"https://www.thesoupcompanyiceland.com/","kind":"food","tag":"Priority","cost":"À la carte.","note":"","location":"The Soup Company, Vík"},{"id":"katla-wool-local-crafts-82425","time":"14:30–15:15","title":"Katla Wool — local crafts","desc":"Browse Icelandic wool sweaters, handmade goods and local textiles. Verify current shop hours.","lat":63.418,"lon":-19.0069,"url":"https://woolkatla.com/","kind":"culture","tag":"Priority","cost":"Free to browse.","note":"","location":"Katla Wool, Vík"},{"id":"skool-beans-coffee-stop-82428","time":"15:30–16:00","title":"Skool Beans — coffee stop","desc":"Coffee or hot cocoa in a converted school bus. Opening days may be limited in autumn.","lat":63.4172,"lon":-19.011,"url":"https://www.skoolbeans.com/","kind":"food","tag":"Optional","cost":"À la carte; seasonal hours.","note":"","location":"Skool Beans café, Vík"},{"id":"v-k-church-and-village-viewpoint-82422","time":"16:15–17:00","title":"Vík church and village viewpoint","desc":"A brief photo stop with panoramic village and coastline views. Access is by road, with walking optional.","lat":63.4204,"lon":-19.0017,"url":"https://www.south.is/en/destinations/towns-regions/towns/vik","kind":"sight","tag":"Priority","cost":"Free outdoor viewpoint.","note":"","location":"Víkurkirkja, Vík í Mýrdal","priceISK":0,"priceBasis":"free general admission · parking may cost extra","priceNote":"Road and parking fees excluded"},{"id":"dinner-and-second-night-in-v-k-82427","time":"Evening","title":"Dinner and second night in Vík","desc":"Enjoy a relaxed evening. Watch for Northern Lights if skies clear, away from local lighting and without taking unnecessary night drives.","lat":63.4182,"lon":-19.0086,"url":"https://en.vedur.is/weather/forecasts/aurora","kind":"food","tag":"Priority","cost":"","note":"","location":"Vík, Iceland"}],"notes":"Choose ONE excursion, not all three. Your attached Vík PDF provided the Katla and buggy options; the private glacier hike is an additional option because your group expressed a specific interest in hiking ON a glacier. Departure times are targets only; operator confirmation required."},{"id":"golden","nav":"Day 4","eyebrow":"FULL DAY 4 • GOLDEN CIRCLE","title":"Vík → Gullfoss, Geysir & Laugarás Lagoon","lead":"Drive northwest from Vík and finish with geothermal bathing and dinner. The major change from your attached Golden Circle PDF: Þingvellir is moved to Day 5 to avoid a big westward detour today.","route":"Vík → Gullfoss → Geysir → Friðheimar → Laugarás","overnight":"Golden Circle countryside • local overnight (location TBD)","pace":"Full but well sequenced • earlier start","stops":[{"id":"depart-v-k-82425","time":"07:30","title":"Depart Vík","desc":"Start early for the long countryside transfer; take a comfort stop and drive on paved main roads.","lat":63.4188,"lon":-19.0064,"url":"https://umferdin.is/en","kind":"travel","tag":"Priority","cost":"","note":"","location":"Vík í Mýrdal"},{"id":"gullfoss-waterfall-84447","time":"10:15–11:00 • estimated","title":"Gullfoss waterfall","desc":"View the upper cascade and canyon from a comfortable designated viewpoint. The longest drive is now behind you.","lat":64.3271,"lon":-20.1199,"url":"https://www.south.is/en/place/gullfoss-waterfall","kind":"sight","tag":"Priority","cost":"Free viewpoint; parking policies may apply.","note":"","location":"Gullfoss, Iceland"},{"id":"geysir-strokkur-geothermal-area-84612","time":"11:15–12:00","title":"Geysir / Strokkur geothermal area","desc":"Watch Strokkur erupt and see steaming vents from the marked paths. If everyone is tired, make this a shorter stop.","lat":64.3104,"lon":-20.3024,"url":"https://www.south.is/en/place/geysir-geothermal-area","kind":"sight","tag":"Priority","cost":"No standard admission.","note":"","location":"Geysir, Haukadalur, Iceland"},{"id":"local-find-bruarfoss-2027","time":"Between Geysir and Friðheimar • optional detour","title":"Brúarfoss — brilliant blue-water waterfall","desc":"Turquoise waterfall reached by a short approximately 5-minute walk from a paid parking lot near Road 37. A lovely choice for the full group if you prefer another waterfall instead of spending longer at Geysir. Adds driving and 30–45 minutes overall, so adjust lunch and spa reservations rather than assuming the current times still work.","lat":64.26424,"lon":-20.51587,"url":"https://guidetoiceland.is/travel-iceland/drive/bruarfoss-waterfall","kind":"sight","tag":"Optional discovery","cost":"No normal waterfall admission; PAID parking (amount varies).","note":"Choose official paid parking from Road 37. Do not navigate private summerhouse roads or attempt the old long river trail as a shortcut.","location":"Brúarfoss Waterfall / Hlauptunga Parking, Iceland"},{"id":"fri-heimar-greenhouse-lunch-84624","time":"12:40–13:50 • reserve","title":"Friðheimar greenhouse lunch","desc":"Eat among tomato plants at the geothermal greenhouse. Tomato soup, fresh bread and other dishes; book a table well ahead.","lat":64.1766,"lon":-20.4471,"url":"https://www.dineout.is/fridheimar","kind":"food","tag":"Priority","cost":"À la carte.","note":"Official restaurant currently runs 11:30–16:00 daily.","location":"Friðheimar, Reykholt, Bláskógabyggð"},{"id":"laugar-s-lagoon-afternoon-spa-84463","time":"14:15–17:15","title":"Laugarás Lagoon — afternoon spa","desc":"Unhurried geothermal soaking, showers and changing. Reserve an afternoon time slot with sufficient time before dinner.","lat":64.1254,"lon":-20.3378,"url":"https://www.laugaraslagoon.is/","kind":"spa","tag":"Priority","cost":"Choose admission tier; 2027 pricing TBD.","note":"Operator currently lists autumn hours 10:00–21:00.","location":"Laugarás Lagoon, Laugarás, Iceland","priceISK":6900,"priceISKMax":9900,"priceBasis":"per adult · Birki standard admission","priceNote":"Published 2026 range; Lerki ISK 9,400–12,400; Ösp ISK 15,900–18,900. Dinner separate."},{"id":"ylja-seasonal-icelandic-dinner-84465","time":"17:30–19:00","title":"Ylja — seasonal Icelandic dinner","desc":"Dine at the lagoon restaurant after changing. This follows the original PDF dinner idea while avoiding a long drive afterward.","lat":64.1262,"lon":-20.339,"url":"https://experience.laugaraslagoon.is/restaurant/ylja?YLJA=1&currency=isk","kind":"food","tag":"Priority","cost":"Separate dinner reservation.","note":"Autumn schedule currently has Ylja open into the evening; confirm for 2027.","location":"Ylja Restaurant, Laugarás Lagoon"},{"id":"stay-locally-near-golden-circle-84600","time":"After dinner","title":"Stay locally near Golden Circle","desc":"Select a nearby overnight base later. The planning priority is avoiding a long drive in darkness after spa and dinner.","lat":64.1617,"lon":-20.4379,"url":"https://umferdin.is/en","kind":"hotel","tag":"Priority","cost":"","note":"","location":"Reykholt, South Iceland"}],"notes":"Why not Þingvellir on this day? The original attached plan departed from Reykholt and visited Þingvellir first; when coming from Vík, that creates an unnecessary zigzag before Geysir, Gullfoss and dinner at Laugarás. We preserve Þingvellir as the centerpiece of Day 5. Alternative: add it today only if you deliberately reduce spa time and accept longer driving."},{"id":"west","nav":"Day 5","eyebrow":"FULL DAY 5 • HISTORY & HOT SPRINGS","title":"Þingvellir, geothermal bread & a final hot spring","lead":"Complete the Golden Circle history on a westbound route, then choose a second kind of geothermal experience before returning toward Reykjavík or Keflavík.","route":"Golden Circle countryside → Laugarvatn → Þingvellir → Hvalfjörður → Reykjavík","overnight":"Reykjavík or near Keflavík • depending on departure flight","pace":"Moderate • flexible spa choice","stops":[{"id":"local-find-skalholt-2027","time":"09:45–10:30 • optional morning history","title":"Skálholt Cathedral — historic Icelandic center","desc":"A strong closer-to-route alternative to the remote Sænautasel turf house. Skálholt was a major Icelandic religious and cultural center; the cathedral has stained glass, bishop graves and a basement exhibit, and nearby Þorláksbúð resembles historic turf architecture. Visit before the Fontana bread tour if staying locally. Confirm access during services.","lat":64.12674,"lon":-20.52564,"url":"https://www.skalholt.is/en/heimsokn","kind":"history","tag":"Optional discovery","cost":"Cathedral entry terms and any museum fees: check ahead.","note":"Public hours currently listed 09:00–18:00. Guided groups usually require 10+; four can self-visit.","location":"Skálholt Cathedral, Skálholt, Iceland"},{"id":"laugarvatn-fontana-geothermal-bread-experience-84948","time":"11:45–12:30 • reserve","title":"Laugarvatn Fontana — geothermal bread experience","desc":"A guided demonstration of traditional rye bread baked using underground geothermal heat. Add a short bath if preferred and the schedule allows.","lat":64.2149,"lon":-20.7326,"url":"https://fontana.is/rye-bread-tour","kind":"culture","tag":"Priority","cost":"Book tour; bathing separate.","note":"Operator currently lists October bakery departures at 11:45 and 14:30; reserve 11:45. Confirm exact 2027 timetable.","location":"Laugarvatn Fontana, Laugarvatn, Iceland","priceISK":3500,"priceBasis":"adult · ISK 3,000 senior","priceNote":"2 adults + 2 seniors: ISK 13,000; bathing not included","priceGroupISK":13000},{"id":"laugarvatn-bakery-caf-light-lunch-84948","time":"12:30–13:00","title":"Laugarvatn bakery café / light lunch","desc":"Enjoy bread, soup or a relaxed café lunch near Fontana before driving west toward Þingvellir. Confirm café availability.","lat":64.2154,"lon":-20.733,"url":"https://fontana.is/","kind":"food","tag":"Priority","cost":"","note":"","location":"Laugarvatn Fontana, Laugarvatn"},{"id":"ingvellir-national-park-85384","time":"13:35–14:45","title":"Þingvellir National Park","desc":"Explore Iceland’s Alþingi parliamentary heritage and rift valley viewpoints. Use short, relatively easy routes; keep walking to your group’s comfort.","lat":64.2552,"lon":-21.129,"url":"https://www.thingvellir.is/en/","kind":"history","tag":"Priority","cost":"Parking and some exhibits may have charges.","note":"","location":"Þingvellir National Park, Iceland"},{"id":"hvammsv-k-hot-springs-fjord-soaking-86019","time":"16:00–17:45 • optional","title":"Hvammsvík Hot Springs — fjord soaking","desc":"A dramatic set of natural hot pools on Hvalfjörður. This is a scenic detour; the natural rock surfaces can be sharp and slippery, so only choose it if the whole group is comfortable.","lat":64.3267,"lon":-21.6925,"url":"https://hvammsvik.com/","kind":"spa","tag":"Optional","cost":"Spa ticketed; 2027 rates TBD.","note":"Safer alternative for uneasy footing: skip this stop and enjoy Reykjavík or a conventional city pool.","location":"Hvammsvík Hot Springs, Hvalfjörður, Iceland"},{"id":"local-find-reykjabod-2027","time":"Late afternoon • optional SPA ALTERNATIVE","title":"Reykjaböð — new Hveragerði geothermal spa","desc":"Recently opened geothermal lagoon beside Reykjadalur in Hveragerði. It has warm pools and sauna facilities. This is an alternative to Hvammsvík—not an extra stop on top of it. Choosing it sends you south via Hveragerði toward Reykjavík instead of northwest to Hvalfjörður. Plan route and drive time accordingly.","lat":64.02292,"lon":-21.21111,"url":"https://reykjabod.is/","kind":"spa","tag":"Optional alternative","cost":"","note":"Current official starting price ISK 8,900 per adult for Hot Springs Pass; premium Bathhouse Pass from ISK 16,900. 2027 pricing unconfirmed.","location":"Reykjaböð Hot Springs, Árhólmar 5, Hveragerði, Iceland","priceISK":8900,"priceBas