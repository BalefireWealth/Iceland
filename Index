function stopById(id){const d=day(),i=d.stops.findIndex(s=>s.id===id);return {d,i,s:d.stops[i]};}
function field(name,value,wide=false,textarea=false){return `<div class="field ${wide?'wide':''}"><label for="f-${esc(name)}">${esc(name)}</label>${textarea?`<textarea id="f-${esc(name)}" name="${esc(name)}">${esc(value)}</textarea>`:`<input id="f-${esc(name)}" name="${esc(name)}" value="${esc(value)}">`}</div>`;}
function modal(title,fields,callback){$('modal-target').innerHTML=`<div class="modalBack"><div class="modal" role="dialog" aria-modal="true"><h2>${esc(title)}</h2><form id="edit-form"><div class="form-grid">${fields}</div><div class="modal-footer"><button class="btn" type="button" data-close>Cancel</button><button class="btn teal" type="submit">Save changes</button></div></form></div></div>`;$('edit-form').onsubmit=e=>{e.preventDefault();const vals=Object.fromEntries(new FormData(e.currentTarget).entries());callback(vals);$('modal-target').innerHTML='';save();render();toast('Changes saved in your browser')};$('modal-target').querySelector('[data-close]').onclick=()=>$('modal-target').innerHTML='';}
function openDay(){let d=day();modal('Edit this day',field('nav',d.nav)+field('eyebrow',d.eyebrow)+field('title',d.title,true)+field('lead',d.lead,true,true)+field('route',d.route,true)+field('overnight',d.overnight,true)+field('pace',d.pace,true)+field('notes',d.notes,true,true),v=>Object.assign(d,v));}
function openTrip(){const fields=['heading','strap','season','travelers','flightHeidi','flightStephanie','returnHeidi','returnStephanie','meeting','car','tripNote','rateISKPerUSD'];const labels={heading:'heading',strap:'strap',season:'season',travelers:'travelers',flightHeidi:'flightHeidi',flightStephanie:'flightStephanie',returnHeidi:'returnHeidi',returnStephanie:'returnStephanie',meeting:'meeting',car:'car',tripNote:'tripNote',rateISKPerUSD:'rateISKPerUSD'};modal('Edit trip details, flights & driver',fields.map(k=>field(labels[k],DATA[k],true,['strap','tripNote'].includes(k))).join(''),v=>{Object.assign(DATA,v);DATA.rateISKPerUSD=Number(v.rateISKPerUSD)||122.096;});}
function openStop(id){let {d,i,s}=stopById(id);const blank=!s; if(blank){s={id:'custom-'+Date.now(),time:'TBD',title:'New activity',desc:'',tag:'Optional',kind:'sight',cost:'',note:'',url:'',location:'Iceland',lat:64.15,lon:-21.94}}const keys=['time','title','desc','tag','cost','priceISK','priceISKMax','priceUSD','priceBasis','priceNote','note','url','location','lat','lon'];const fields=keys.map(k=>field(k,String(s[k]??''),true,['desc','note'].includes(k))).join('');modal(blank?'Add a stop':'Edit stop details',fields,v=>{Object.assign(s,v);s.lat=Number(v.lat)||0;s.lon=Number(v.lon)||0;for(const k of ['priceISK','priceISKMax','priceUSD']){if(v[k]===''||v[k]===undefined){delete s[k]}else s[k]=Number(v[k])||0;}if(blank)d.stops.push(s);else d.stops[i]=s});}
function adjustStop(id,action){const {d,i}=stopById(id);if(i<0)return;if(action==='delete'){if(!confirm('Delete this stop?'))return;d.stops.splice(i,1);}else{const to=i+(action==='up'?-1:1);if(to<0||to>=d.stops.length)return;[d.stops[i],d.stops[to]]=[d.stops[to],d.stops[i]];}save();render();}
// EMBEDDED MAP — no external map tiles, remote JS or map API required.
const MAP_BOUNDS={west:-25,east:-13,south:62.75,north:66.75,W:1120,H:700};
let view={x:0,y:0,w:1120,h:700},selectedMapPin=null,dragStart=null;
const geoXY=(lat,lon)=>({x:(Number(lon)-MAP_BOUNDS.west)/(MAP_BOUNDS.east-MAP_BOUNDS.west)*MAP_BOUNDS.W,y:(MAP_BOUNDS.north-Number(lat))/(MAP_BOUNDS.north-MAP_BOUNDS.south)*MAP_BOUNDS.H});
function visibleMapStops(){return MAP_MODE==='all'?DATA.days.flatMap(d=>activeStops(d).map(s=>({...s,_day:d.nav}))):activeStops(day()).map(s=>({...s,_day:day().nav}));}
const mapPoints=()=>visibleMapStops().filter(s=>Number.isFinite(Number(s.lat))&&Number.isFinite(Number(s.lon))&&Number(s.lat)>0&&Number(s.lon)<0);
function boundedView(v){const aspect=Math.max(.75,$('map').clientWidth/Math.max(200,$('map').clientHeight));let w=Math.max(125,Math.min(1120,v.w)),h=Math.max(80,Math.min(700,v.h));if(w/h>aspect)h=w/aspect;else w=h*aspect;if(w>1120){w=1120;h=w/aspect}if(h>700){h=700;w=h*aspect}let x=Math.min(1120-w,Math.max(0,v.x+(v.w-w)/2)),y=Math.min(700-h,Math.max(0,v.y+(v.h-h)/2));return{x,y,w,h};}
function fitMap(){const items=mapPoints();let xs=items.map(s=>geoXY(s.lat,s.lon).x),ys=items.map(s=>geoXY(s.lat,s.lon).y);if(!xs.length){view=boundedView({x:140,y:275,w:700,h:370})}else{let xmin=Math.min(...xs),xmax=Math.max(...xs),ymin=Math.min(...ys),ymax=Math.max(...ys),w=Math.max(195,xmax-xmin+165),h=Math.max(140,ymax-ymin+135);view=boundedView({x:(xmin+xmax-w)/2,y:(ymin+ymax-h)/2,w,h})}drawMap();}
function drawMap(){const svg=$('geo-svg');svg.setAttribute('viewBox',`${view.x} ${view.y} ${view.w} ${view.h}`);const items=mapPoints(),line=$('day-line');let points=items.map(s=>geoXY(s.lat,s.lon));line.innerHTML=MAP_MODE==='day'&&points.length>1?`<polyline points="${points.map(p=>`${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ')}"/>`:'';
// Cluster close places on screen. All markers stay at their true coordinates; click a cluster to zoom or view its list.
let clusters=[];const mapEl=$('map'),cw=mapEl.clientWidth,ch=mapEl.clientHeight;
items.forEach((s,i)=>{const p=geoXY(s.lat,s.lon),xx=(p.x-view.x)/view.w*cw,yy=(p.y-view.y)/view.h*ch;if(xx<0||xx>cw||yy<0||yy>ch)return;
let cl=clusters.find(c=>Math.hypot(c.px-xx,c.py-yy)<34);if(cl){cl.items.push({s,i});cl.px=(cl.px*(cl.items.length-1)+xx)/cl.items.length;cl.py=(cl.py*(cl.items.length-1)+yy)/cl.items.length;}
else clusters.push({px:xx,py:yy,items:[{s,i}]});});
$('pin-layer').innerHTML=clusters.map((c,i)=>{let many=c.items.length>1,n=c.items[0].i+1,label=many?c.items.length:n;let names=c.items.map(x=>x.s.title).join(', ');let klass=many?'map-cluster':(isOptional(c.items[0].s)?'optional':'');return `<button type="button" class="pin-button ${klass}" style="left:${(c.px/cw*100).toFixed(3)}%;top:${(c.py/ch*100).toFixed(3)}%" ${many?`data-cluster="${i}"`:`data-pin="${esc(c.items[0].s.id)}"`} title="${esc(many?c.items.length+' nearby places: '+names:n+'. '+names)}">${label}</button>`}).join('');
window.mapClusters=clusters;
const towns=[['Reykjavík',64.145,-21.94],['KEF',63.985,-22.606],['Hella',63.835,-20.398],['Skógar',63.52,-19.50],['Vík',63.42,-19.01],['Laugarás',64.126,-20.34],['Gullfoss',64.327,-20.12],['Þingvellir',64.255,-21.13]];
$('map-city-labels').innerHTML=towns.map(([n,lat,lon])=>{const p=geoXY(lat,lon);const x=(p.x-view.x)/view.w*100,y=(p.y-view.y)/view.h*100;return (x>3&&x<94&&y>2&&y<93)?`<span class="city-name" style="left:${x.toFixed(3)}%;top:${y.toFixed(3)}%">${esc(n)}</span>`:''}).join('');}
function openMapCluster(index){const c=(window.mapClusters||[])[index];if(!c)return;const maxPlaces=c.items.length;
if(view.w>165 && maxPlaces>1){const p=geoXY(c.items[0].s.lat,c.items[0].s.lon),w=Math.max(125,view.w*.52),h=w*$('map').clientHeight/Math.max(200,$('map').clientWidth);view=boundedView({x:p.x-w/2,y:p.y-h/2,w,h});drawMap();}
const close=`<button type="button" data-map-close aria-label="Close location details">×</button>`;
$('map-detail').innerHTML=close+`<strong>${maxPlaces} nearby stops</strong><small>Zoom in for more detail, or select an activity:</small>`+c.items.map(({s,i})=>`<a href="${esc(where(s))}" target="_blank" rel="noopener noreferrer" title="Open directions for ${esc(s.title)}">${i+1}. ${esc(s.title)} ↗</a>`).join('<div style="height:4px"></div>');$('map-detail').classList.remove('hidden');}
function showMapDetail(s){selectedMapPin=s.id;const url=safe(s.url);$('map-detail').innerHTML=`<button type="button" data-map-close aria-label="Close location details">×</button><strong>${esc(s.title)}</strong><small>${esc(s._day||day().nav)} · ${esc(s.time)} · ${esc(s.location||'Iceland')}</small>${url?`<a target="_blank" rel="noopener noreferrer" href="${esc(url)}">Website / details ↗</a>`:''}<a target="_blank" rel="noopener noreferrer" href="${esc(where(s))}">Google Maps directions ↗</a>`;$('map-detail').classList.remove('hidden');}
function updateMap(){const md=MAP_MODE==='day';$('map-day').classList.toggle('on',md);$('map-all').classList.toggle('on',!md);$('map-day').setAttribute('aria-pressed',md);$('map-all').setAttribute('aria-pressed',!md);$('map-desc').textContent=md?'Pins follow this day. Numbered circles are individual stops; numbered clusters represent nearby stops. Tap to explore.':'All seven days shown. Tap any pin to see the place.';$('map-detail').classList.add('hidden');fitMap();}
function zoomGeo(f){const center={x:view.x+view.w/2,y:view.y+view.h/2};let w=view.w*f,h=view.h*f;view=boundedView({x:center.x-w/2,y:center.y-h/2,w,h});drawMap();}
function focusPin(id){if(MAP_MODE!=='day'){MAP_MODE='day';updateMap()};let s=mapPoints().find(x=>x.id===id);if(!s){MAP_MODE='all';updateMap();s=mapPoints().find(x=>x.id===id);}if(!s)return;let p=geoXY(s.lat,s.lon),w=Math.min(view.w,275),h=w*Math.max(200,$('map').clientHeight)/Math.max(350,$('map').clientWidth);view=boundedView({x:p.x-w/2,y:p.y-h/2,w,h});drawMap();showMapDetail(s);if(window.innerWidth<=850)$('map').scrollIntoView({behavior:'smooth',block:'center'});}
$('pin-layer').addEventListener('click',e=>{const pin=e.target.closest('[data-pin]');if(pin){const s=mapPoints().find(x=>x.id===pin.dataset.pin);if(s)showMapDetail(s);return;}const cluster=e.target.closest('[data-cluster]');if(cluster)openMapCluster(Number(cluster.dataset.cluster));});
$('map-detail').addEventListener('click',e=>{if(e.target.closest('[data-map-close]'))$('map-detail').classList.add('hidden')});
$('geo-plus').onclick=()=>zoomGeo(.75);$('geo-minus').onclick=()=>zoomGeo(1.33);$('geo-reset').onclick=fitMap;
$('map').addEventListener('wheel',e=>{if(!e.ctrlKey)return;e.preventDefault();zoomGeo(e.deltaY>0?1.20:.83)},{passive:false});
$('map').querySelector('.geo-canvas').addEventListener('pointerdown',e=>{if(e.target.closest&&e.target.closest('[data-pin], [data-cluster]'))return;dragStart={x:e.clientX,y:e.clientY,v:{...view}};e.currentTarget.classList.add('dragging');e.currentTarget.setPointerCapture(e.pointerId)});
$('map').querySelector('.geo-canvas').addEventListener('pointermove',e=>{if(!dragStart)return;const el=$('map');const dx=(e.clientX-dragStart.x)/el.clientWidth*dragStart.v.w,dy=(e.clientY-dragStart.y)/el.clientHeight*dragStart.v.h;view=boundedView({...dragStart.v,x:dragStart.v.x-dx,y:dragStart.v.y-dy});drawMap()});
['pointerup','pointercancel','lostpointercapture'].forEach(ev=>$('map').querySelector('.geo-canvas').addEventListener(ev,e=>{dragStart=null;e.currentTarget.classList.remove('dragging')}));
window.addEventListener('resize',()=>{view=boundedView(view);drawMap()});
function exportHTML(){save();let source='<!doctype html>\n'+document.documentElement.outerHTML;const baked=structuredClone(DATA);baked.version=Date.now();const boot=JSON.stringify(baked).replace(/</g,'\\u003c');const re=/<script id="trip-boot-data" type="application\/json">[\s\S]*?<\/script>/;source=source.replace(re,'<script id="trip-boot-data" type="application/json">'+boot+'<\/script>'); // Restore JS-generated regions as they will be rendered on page load.
download('Iceland_2027_Family_Itinerary_UPDATED.html',source,'text/html;charset=utf-8');toast('Updated publish-ready HTML downloaded');}
function download(name,content,mime){const a=document.createElement('a');const blob=new Blob([content],{type:mime});a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},350);}
function exportJSON(){download('Iceland_2027_Itinerary_Backup.json',JSON.stringify(DATA,null,2),'application/json');toast('Trip backup downloaded');}
$('edit-toggle').onclick=()=>{EDIT=!EDIT;render();toast(EDIT?'Editing enabled · auto-saving changes':'Editing closed')};$('export-html').onclick=exportHTML;
$('day-tabs').addEventListener('click',e=>{let btn=e.target.closest('[data-day]');if(btn){DAY=btn.dataset.day;render();window.scrollTo({top:0,behavior:'smooth'});}});
$('prep-content').addEventListener('change',e=>{const ch=e.target.closest('[data-prepcheck]');if(ch){DATA.prepChecks[ch.dataset.prepcheck]=ch.checked;save();refreshPrepProgress();}});$('prep-content').addEventListener('click',e=>{if(e.target.id==='prep-save-notes'){DATA.prepNotes=$('prep-note-input').value;save();renderPrep();toast('Travel prep notes saved in this browser');}});
$('stop-list').addEventListener('click',e=>{const focus=e.target.closest('[data-mapfocus]');if(focus){focusPin(focus.dataset.mapfocus);return}const el=e.target.closest('[data-action]');if(!el)return;const action=el.dataset.action;if(action==='editStop')openStop(el.dataset.id);else if(['up','down','delete'].includes(action))adjustStop(el.dataset.id,action);});
$('stop-list').addEventListener('change',e=>{if(e.target.matches('[data-time]')){let {s}=stopById(e.target.dataset.time);if(s){s.time=e.target.value.trim()||'TBD';save();render()}}});
$('adventure-picker').addEventListener('change',e=>{if(e.target.name==='adventure'){DATA.adventure=e.target.value;save();render()}});
function actionListener(e){let a=e.target.closest('[data-action]');if(!a)return;switch(a.dataset.action){case 'editDay':openDay();break;case 'editTrip':openTrip();break;case 'addStop':openStop();break;case 'exportJSON':exportJSON();break;case 'reset':if(confirm('Reset every edit back to the original itinerary?')){DATA=structuredClone(INITIAL);localStorage.removeItem(STORE_KEY);render();toast('Original itinerary restored')}break;}}
$('edit-tools').addEventListener('click',actionListener);$('day-notes').addEventListener('click',actionListener);$('travel-panel').addEventListener('click',actionListener);
$('map-day').onclick=()=>{MAP_MODE='day';updateMap()};$('map-all').onclick=()=>{MAP_MODE='all';updateMap()};
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('modal-target').firstChild)$('modal-target').innerHTML=''});
render();
})();
</script>
